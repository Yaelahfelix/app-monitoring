# Shared secret that client repos' GitHub Actions must send as
# `Authorization: Bearer <INGEST_TOKEN>` when POSTing to /api/ingest.
INGEST_TOKEN=change-me-to-a-long-random-string

# Postgres connection string. On Vercel, provisioned automatically when you
# run `vercel integration add neon` (or install Neon from the Marketplace)
# and then `vercel env pull .env.local`. For local dev, point this at any
# Postgres/Neon database.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
